# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SITE_URL: Single source for canonical URLs, sitemap, hreflang, OG URLs.
# Default: https://gosaveclip.online
NEXT_PUBLIC_SITE_URL="https://gosaveclip.online"

# NEXT_PUBLIC_GSC_VERIFICATION: Google Search Console verification meta tag token (optional)
NEXT_PUBLIC_GSC_VERIFICATION=""

# NEXT_PUBLIC_GA4_ID: Google Analytics 4 / Google Tag Measurement ID (e.g. G-XXXXXXXXXX)
# Used for Google Metrics, traffic analysis, custom download events, and Core Web Vitals tracking.
NEXT_PUBLIC_GA4_ID="G-GOSAVECLIP1"

# NEXT_PUBLIC_WEB3FORMS_KEY: Web3Forms access key for direct email forwarding from contact form
NEXT_PUBLIC_WEB3FORMS_KEY="5175c12f-4b2c-47f4-afce-2d75efed0e5a"
